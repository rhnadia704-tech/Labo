# Enforce binary handling for all binaries and archives
*.jar binary
*.keystore binary
*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.img binary
*.labx binary
*.zip binary

# Standard text file normalization
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
gradlew text eol=lf
